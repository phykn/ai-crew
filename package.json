{
  "name": "ai-crew",
  "version": "0.1.0",
  "private": true,
  "description": "A local desktop workspace for an AI crew",
  "author": "phykn",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:desktop": "node scripts/desktop-smoke.mjs"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "asar": true
      },
      "plugins": [
        {
          "name": "@electron-forge/plugin-vite",
          "config": {
            "build": [
              {
                "entry": "src/main.ts",
                "config": "vite.main.config.ts"
              },
              {
                "entry": "src/preload.ts",
                "config": "vite.main.config.ts"
              }
            ],
            "renderer": [
              {
                "name": "main_window",
                "config": "vite.renderer.config.ts"
              }
            ]
          }
        }
      ]
    }
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.93",
    "ai": "7.0.177",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "45.4.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
